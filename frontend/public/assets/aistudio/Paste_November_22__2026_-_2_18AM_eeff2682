    document.getElementById('hybridSubsidyCost').innerText = '- ' + formatInr(subsidy);
    document.getElementById('hybridNetPayable').innerText = formatInr(hybridCost - subsidy - 12000);

    document.getElementById('bomSystemLabel').innerText = `${num} kW Custom Engineered Array`;
    document.getElementById('bomPvQty').innerText = `${panelCount} Nos`;
    document.getElementById('bomPvTotal').innerText = formatInr(panelCount * 16500);
    document.getElementById('bomRackingQty').innerText = `${panelCount} Panels`;
