    }
  }

  if (globeStage) {
    if (progress < 0.70) {
      const factor = progress / 0.70;
      const currentScale = 1.85 - (factor * 1.05);
      const currentLeft = 76 - (factor * 26);
      const currentTop = 42 + (factor * 8);
