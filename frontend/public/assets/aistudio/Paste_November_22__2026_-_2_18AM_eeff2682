    document.getElementById('annualSavings').innerText = `₹${(Math.round(num * 125 * 12 * 7.5)).toLocaleString('en-IN')} / yr`;
    document.getElementById('onGridGrossCost').innerText = formatInr(grossCost);
    document.getElementById('onGridSubsidyCost').innerText = '- ' + formatInr(subsidy);
    
    const onGridNet = Math.max(0, grossCost - subsidy - 3500);
    document.getElementById('onGridNetPayable').innerText = formatInr(onGridNet);

    document.getElementById('batterySpec').innerText = `${(num * 3.3).toFixed(1)} kWh LiFePO4 Module`;
    document.getElementById('hybridInverterSpec').innerText = `${num}kW Multi-Mode Storage Inverter`;
