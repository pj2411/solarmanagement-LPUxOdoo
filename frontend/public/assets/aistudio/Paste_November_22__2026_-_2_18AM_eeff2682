function updateAdvancedCalc() {
  const slider = document.getElementById('calcSlider');
  const billLabel = document.getElementById('billLabel');
  const schemeElem = document.getElementById('calcScheme');
  const gridTypeElem = document.getElementById('calcGridType');
  if (!slider) return;
  const bill = parseInt(slider.value, 10);
  const scheme = schemeElem ? schemeElem.value : 'pmsuryaghar';
  const gridType = gridTypeElem ? gridTypeElem.value : 'ongrid';
  if (billLabel) billLabel.textContent = '₹' + bill.toLocaleString('en-IN') + ' / mo';
  let kw = (bill / 1300);
  if (kw < 1.0) kw = 1.0;
  if (kw > 15.0) kw = 15.0;
  kw = parseFloat(kw.toFixed(1));
  let roofArea = Math.round(kw * 90);
  let grossPrice = Math.round(kw * 65000);
  if (gridType === 'hybrid') grossPrice += Math.round(kw * 35000);
  let subsidy = 0;
  if (scheme === 'pmsuryaghar') {
    subsidy = kw <= 2.0 ? Math.round(30000 * kw) : 78000;
  } else if (scheme === 'commercial') {
    subsidy = Math.round(grossPrice * 0.40);
  } else {
    subsidy = 0;
  }
  let netPrice = Math.max(grossPrice - subsidy, 20000);
  let annualSavings = Math.round(bill * 12 * 0.90);
  let paybackYears = (netPrice / annualSavings).toFixed(1);
  if (paybackYears < 2.2) paybackYears = '2.2';
  let lifetime = Math.round(annualSavings * 25);
  let co2 = (kw * 24.2).toFixed(1);

  const rKw = document.getElementById('recKw');
  if (rKw) rKw.textContent = kw + ' kW';
  const rRoof = document.getElementById('recRoofSqFt');
  if (rRoof) rRoof.textContent = '~' + roofArea + ' sq.ft area';
  const rSub = document.getElementById('recSubsidy');
  if (rSub) rSub.textContent = '₹' + subsidy.toLocaleString('en-IN');
  const rAnn = document.getElementById('recAnnual');
  if (rAnn) rAnn.textContent = '₹' + annualSavings.toLocaleString('en-IN');
  const rPay = document.getElementById('recPayback');
  if (rPay) rPay.textContent = paybackYears + ' Yrs';
  const rGross = document.getElementById('recGrossCost');
  if (rGross) rGross.textContent = '₹' + grossPrice.toLocaleString('en-IN');
  const rNet = document.getElementById('recNetCost');
  if (rNet) rNet.textContent = '₹' + netPrice.toLocaleString('en-IN');
  const rLife = document.getElementById('recLifetimeSavings');
  if (rLife) rLife.textContent = '₹' + lifetime.toLocaleString('en-IN');
  const rCo2 = document.getElementById('recCo2Offset');
  if (rCo2) rCo2.textContent = co2 + ' Tonnes';
}

