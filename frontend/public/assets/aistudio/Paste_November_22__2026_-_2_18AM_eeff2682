<script>
  (function initServiceDesk() {
    window.showToast = function(msg, icon = 'check_circle') {
      const toast = document.getElementById('toast-notify');
      const msgEl = document.getElementById('toast-message');
      const iconEl = document.getElementById('toast-icon');
      if (!toast || !msgEl || !iconEl) return;
      msgEl.innerText = msg;
      iconEl.innerText = icon;
      toast.classList.remove('translate-y-24', 'opacity-0');
      toast.classList.add('translate-y-0', 'opacity-100');
      setTimeout(() => {
        toast.classList.add('translate-y-24', 'opacity-0');
        toast.classList.remove('translate-y-0', 'opacity-100');
      }, 3500);
    };

    window.submitNewTicket = function() {
      const category = document.getElementById('ticket-category').value;
      const capacity = document.getElementById('ticket-capacity').value || '5 kW';
      const custname = document.getElementById('ticket-custname').value || 'Customer';
      const tbody = document.getElementById('ticket-table-body');
      
      const randomId = '#TCK-' + Math.floor(1000 + Math.random() * 9000);
      const newRow = document.createElement('tr');
      newRow.className = 'hover:bg-surface-container-low transition-colors rounded-lg group animate-in fade-in duration-200';
      newRow.innerHTML = `
        <td class="py-3 px-3 font-mono font-semibold text-primary">${randomId}</td>
        <td class="py-3 px-3">
          <div class="font-medium text-on-surface">${category}</div>
          <div class="text-[10px] text-on-surface-variant">Direct Customer Portal Entry</div>
        </td>
        <td class="py-3 px-3">
          <div class="font-medium text-on-surface">${custname}</div>
          <div class="text-[10px] text-on-surface-variant">${capacity} &bull; Just Now</div>
        </td>
        <td class="py-3 px-3">
          <div class="flex items-center gap-1.5">
            <div class="w-5 h-5 rounded-full bg-secondary-container text-on-secondary-container flex items-center justify-center text-[10px] font-bold">DIS</div>
            <span class="font-medium">Auto-Assigning...</span>
          </div>
        </td>
        <td class="py-3 px-3">
          <span class="inline-flex items-center gap-1 text-[11px] font-semibold text-surface-tint">
            <span class="material-symbols-outlined text-xs">timer</span> 23h 59m
          </span>
        </td>
        <td class="py-3 px-3">
          <span class="px-2 py-0.5 rounded-full bg-secondary-container text-on-secondary-container text-[10px] font-semibold">
            Technician Dispatched
          </span>
        </td>
      `;

      tbody.insertBefore(newRow, tbody.firstChild);
      window.showToast(`Ticket ${randomId} dispatched to on-call technician!`, 'send');
      document.getElementById('ticket-desc').value = '';
    };

    window.triggerEmergencyDispatch = function() {
      window.showToast('Emergency 24-Hr SLA Protocol initiated. Nearby crew alerted!', 'emergency');
    };

    window.sendWhatsAppPing = function(name) {
      window.showToast(`WhatsApp dispatch ping sent to ${name} with GPS payload!`, 'chat');
    };

    window.openOtpClosureModal = function() {
      const modal = document.getElementById('otp-modal');
      if (modal) modal.classList.remove('hidden');
    };

    window.closeOtpModal = function() {
      const modal = document.getElementById('otp-modal');
      if (modal) modal.classList.add('hidden');
    };

    window.confirmClosure = function() {
      window.closeOtpModal();
      window.showToast('Customer OTP Verified! Ticket #TCK-8812 marked Closed.', 'verified');
    };

    const quickBtn = document.getElementById('quick-ticket-btn');
    if (quickBtn) {
      quickBtn.addEventListener('click', () => {
        const formCard = document.getElementById('service-form-card');
        if (formCard) {
          formCard.scrollIntoView({ behavior: 'smooth', block: 'start' });
          formCard.classList.add('ring-2', 'ring-surface-tint');
          setTimeout(() => formCard.classList.remove('ring-2', 'ring-surface-tint'), 1500);
        }
      });
