<script>
  function selectRole(button, roleName) {
    // Unselect all pills
    const pills = document.querySelectorAll('.role-pill');
    pills.forEach(pill => {
      pill.classList.remove('active-role', 'bg-surface-container-lowest', 'text-primary', 'shadow-sm');
      pill.classList.add('text-on-surface-variant');
    });

    // Select clicked pill
    button.classList.add('active-role', 'bg-surface-container-lowest', 'text-primary', 'shadow-sm');
    button.classList.remove('text-on-surface-variant');

    // Update role display indicator
    const indicator = document.getElementById('selectedRoleIndicator');
    if (indicator) {
      indicator.textContent = roleName;
    }
  }

  function togglePasswordVisibility() {
    const passwordInput = document.getElementById('userPassword');
    const passwordIcon = document.getElementById('passwordIcon');
    
    if (passwordInput.type === 'password') {
      passwordInput.type = 'text';
      passwordIcon.textContent = 'visibility_off';
    } else {
      passwordInput.type = 'password';
      passwordIcon.textContent = 'visibility';
    }
  }

  function toggleForgotPasswordView(showForgot) {
    const signInView = document.getElementById('viewSignIn');
    const forgotView = document.getElementById('viewForgotPassword');

    if (showForgot) {
      signInView.classList.add('hidden');
      forgotView.classList.remove('hidden');
      forgotView.classList.add('flex');
    } else {
      forgotView.classList.add('hidden');
      forgotView.classList.remove('flex');
      signInView.classList.remove('hidden');
      signInView.classList.add('flex');
    }
  }

  function handleLoginSubmit(event) {
    event.preventDefault();
    const btn = event.submitter;
    const originalText = btn.innerHTML;
    btn.innerHTML = '<span class="material-symbols-outlined animate-spin text-base">progress_activity</span> Authenticating Session...';
    btn.disabled = true;

    setTimeout(() => {
      btn.innerHTML = '<span class="material-symbols-outlined text-base">check_circle</span> Access Granted';
      setTimeout(() => {
        btn.innerHTML = originalText;
        btn.disabled = false;
      }, 1500);
    }, 1200);
  }

  function handleOtpRequest(event) {
    event.preventDefault();
    const input = document.getElementById('resetContactInput');
    const val = input.value;
    if (!val) return;

    const btn = event.submitter;
    const orig = btn.innerHTML;
    btn.innerHTML = '<span class="material-symbols-outlined animate-spin text-base">progress_activity</span> Dispatching OTP...';
    btn.disabled = true;

    setTimeout(() => {
      btn.innerHTML = '<span class="material-symbols-outlined text-base">check</span> OTP Sent Successfully';
      setTimeout(() => {
        btn.innerHTML = orig;
        btn.disabled = false;
        toggleForgotPasswordView(false);
      }, 1400);
    }, 1000);
  }
