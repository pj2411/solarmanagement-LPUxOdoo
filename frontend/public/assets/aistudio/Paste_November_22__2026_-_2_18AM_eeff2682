<!-- SCRIPT ENGINE: SCROLL TRANSITIONS, CALCULATOR, FORM HANDLING, AND AUTO-MINIMIZING CTA / DRAWER -->
<script>
    // 1. Calculator Interaction
    const calcSlider = document.getElementById('calcSlider');
    const billLabel = document.getElementById('billLabel');
    const recKw = document.getElementById('recKw');
    const recSubsidy = document.getElementById('recSubsidy');
    const recAnnual = document.getElementById('recAnnual');
    const recPayback = document.getElementById('recPayback');

    if (calcSlider) {
      calcSlider.addEventListener('input', function() {
        const bill = parseInt(this.value, 10);
        billLabel.textContent = `₹${bill.toLocaleString('en-IN')} / mo`;
        
        let kw = (bill / 1300).toFixed(1);
        if (kw < 1.0) kw = 1.0;
        if (kw > 15.0) kw = 15.0;

        let subsidy = kw <= 2.0 ? 30000 * kw : 78000;
        let annual = Math.round(bill * 12 * 0.90);
        let payback = ((120000 * (kw / 2) - subsidy) / annual).toFixed(1);
        if (payback < 2.5) payback = 2.5;

        recKw.textContent = `${kw} kW`;
        recSubsidy.textContent = `₹${Math.round(subsidy).toLocaleString('en-IN')}`;
        recAnnual.textContent = `₹${annual.toLocaleString('en-IN')}`;
        recPayback.textContent = `${payback} Yrs`;
      });
    }

    function populateSystemFromCalc() {
      const kw = recKw.textContent;
      const bill = billLabel.textContent;
      const billInput = document.getElementById('userBillArea');
      if (billInput) {
        billInput.value = `${bill} (Recommended: ${kw} System)`;
      }
    }

    // 2. Interactive Form Submission with exact requested message
    function submitFeasibility(e) {
      e.preventDefault();
      const name = document.getElementById('userName').value || 'Valued Customer';
      const system = document.getElementById('userSystem').value;
      const ref = 'SUN-2025-' + Math.floor(1000 + Math.random() * 9000);

      document.getElementById('confirmedCustomerName').textContent = name;
      document.getElementById('confirmedSystemName').textContent = system;
      document.getElementById('confirmedTracking').textContent = ref;

      document.getElementById('quoteFormWrapper').classList.add('hidden');
      document.getElementById('quoteSuccessCard').classList.remove('hidden');
    }

    function resetFeasibilityForm() {
      document.getElementById('solarQueryForm').reset();
      document.getElementById('quoteSuccessCard').classList.add('hidden');
      document.getElementById('quoteFormWrapper').classList.remove('hidden');
    }

    // 3. Navigation Drawer Functions
    const navDrawer = document.getElementById('navDrawer');
    const drawerBackdrop = document.getElementById('drawerBackdrop');

    function toggleNavDrawer() {
      if (navDrawer.classList.contains('translate-x-full')) {
        openNavDrawer();
      } else {
        closeNavDrawer();
      }
    }

    function openNavDrawer() {
      navDrawer.classList.remove('translate-x-full');
      drawerBackdrop.classList.remove('opacity-0', 'pointer-events-none');
      drawerBackdrop.classList.add('opacity-100', 'pointer-events-auto');
      document.body.style.overflow = 'hidden';
    }

    function closeNavDrawer() {
      navDrawer.classList.add('translate-x-full');
      drawerBackdrop.classList.add('opacity-0', 'pointer-events-none');
      drawerBackdrop.classList.remove('opacity-100', 'pointer-events-auto');
      document.body.style.overflow = '';
    }

    // ESC key listener to dismiss drawer
    window.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && !navDrawer.classList.contains('translate-x-full')) {
        closeNavDrawer();
      }
    });

    // 4. Scroll-Linked Dawn-Day-Dusk-Night Cycle, Earth Repositioning, & Auto-minimizing CTA
    const headerCta = document.getElementById('headerCta');

    window.addEventListener('scroll', function() {
      const scrollY = window.scrollY;
      const maxScroll = document.documentElement.scrollHeight - window.innerHeight;
      const progress = maxScroll > 0 ? Math.min(Math.max(scrollY / maxScroll, 0), 1) : 0;

      // Auto-minimizing CTA trigger (>100px)
      if (headerCta) {
        if (scrollY > 100) {
          if (!headerCta.classList.contains('minimized')) {
            headerCta.classList.remove('expanded', 'px-4');
            headerCta.classList.add('minimized', 'w-10', 'px-0');
          }
        } else {
          if (headerCta.classList.contains('minimized')) {
            headerCta.classList.remove('minimized', 'w-10', 'px-0');
            headerCta.classList.add('expanded', 'px-4');
          }
        }
      }

      const skyGradient = document.getElementById('skyGradient');
      const dawnFlare = document.getElementById('dawnFlare');
      const duskFlare = document.getElementById('duskFlare');
      const nightStars = document.getElementById('nightStars');
      const globeStage = document.getElementById('globeStage');

      // Sky Cycle Transition
      if (progress < 0.22) {
        // Dawn
        skyGradient.style.background = 'linear-gradient(180deg, #FBF6EE 0%, #FAF9F6 50%, #F5F4EE 100%)';
        dawnFlare.style.opacity = (0.75 - progress * 1.5);
        duskFlare.style.opacity = '0';
        nightStars.style.opacity = '0';
      } else if (progress < 0.52) {
        // Day
        skyGradient.style.background = 'linear-gradient(180deg, #F0F6F4 0%, #FAF9F6 50%, #EBF3F0 100%)';
        dawnFlare.style.opacity = '0';
        duskFlare.style.opacity = '0';
        nightStars.style.opacity = '0';
      } else if (progress < 0.76) {
        // Dusk
        const p = (progress - 0.52) / 0.24;
        skyGradient.style.background = 'linear-gradient(180deg, #F9F0E6 0%, #F0E6F0 45%, #D4D4E8 100%)';
        dawnFlare.style.opacity = '0';
        duskFlare.style.opacity = (p * 0.8).toFixed(2);
        nightStars.style.opacity = (p * 0.3).toFixed(2);
      } else {
        // Night
        const p = (progress - 0.76) / 0.24;
        skyGradient.style.background = 'linear-gradient(180deg, #16202A 0%, #0C1622 40%, #03070E 100%)';
        dawnFlare.style.opacity = '0';
        duskFlare.style.opacity = (0.8 * (1 - p)).toFixed(2);
        nightStars.style.opacity = Math.min(0.3 + p * 0.7, 1).toFixed(2);
      }

      // Earth Scaling & Centering Trajectory:
      // Starts BIGGER on the right: scale 1.85, left 76%, top 42%
      // Gradually decreases and moves toward center:
      if (progress < 0.70) {
        const factor = progress / 0.70;
        const currentScale = 1.85 - (factor * 1.05); // decreases to ~0.80
        const currentLeft = 76 - (factor * 26);       // moves from 76% to 50% (center!)
        const currentTop = 42 + (factor * 8);         // smoothly lowers to 50%
        globeStage.style.left = currentLeft.toFixed(1) + '%';
        globeStage.style.top = currentTop.toFixed(1) + '%';
        globeStage.style.transform = `translate(-50%, -50%) scale(${currentScale.toFixed(2)})`;
        globeStage.style.opacity = '1';
      } else {
        // Tucks away and fades behind form & footer so it never obstructs
        const fade = (progress - 0.70) / 0.30;
        globeStage.style.left = '50%';
        globeStage.style.top = '50%';
        globeStage.style.transform = `translate(-50%, -50%) scale(${Math.max(0.8 - fade * 0.4, 0.4).toFixed(2)})`;
        globeStage.style.opacity = Math.max(1 - fade * 3, 0).toFixed(2);
      }
    });
  </script>


