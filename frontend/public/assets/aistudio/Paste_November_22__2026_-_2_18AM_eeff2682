  function handleCustomCapacity(val) {
    const num = parseFloat(val);
    if (!num || num <= 0) return;

    // Remove active style from pills
    document.querySelectorAll('.capacity-pill').forEach(p => {
      p.className = 'capacity-pill shrink-0 px-4 py-2.5 rounded-xl text-xs font-semibold bg-white/70 text-on-surface-variant hover:bg-surface-container-high transition-all shadow-sm';
    });

    const panelCount = Math.ceil((num * 1000) / 550);
    const grossCost = Math.round(num * 58000);
    let subsidy = 78000;
    if (num <= 1) subsidy = 30000;
    else if (num <= 2) subsidy = 60000;
    else subsidy = 78000;

    const hybridCost = Math.round(grossCost * 1.75);

    document.getElementById('onGridPanelCount').innerText = `${panelCount}x Tier-1 Bifacial TopCon (550Wp)`;
    document.getElementById('onGridInverter').innerText = `Industrial Class ${num}kW On-Grid Dual MPPT`;
