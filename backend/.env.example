# ---------- App ----------
APP_NAME=SunPower Solar ERP API
ENVIRONMENT=development
SECRET_KEY=change-this-to-a-long-random-32-byte-key
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# ---------- PostgreSQL (Docker maps host 5433 -> container 5432) ----------
DATABASE_URL=postgresql+psycopg://sunpower:sunpower@localhost:5433/sunpower

# ---------- Redis ----------
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=60
OTP_EXPIRE_SECONDS=300

# ---------- OAuth2 providers ----------
# Callback URL registered with the provider must be:
#   http://localhost:8000/api/v1/auth/oauth/google/callback
#   http://localhost:8000/api/v1/auth/oauth/github/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OAUTH_REDIRECT_BASE_URL=http://localhost:8000
OAUTH_FRONTEND_CALLBACK=http://localhost:5173/oauth/callback

# ---------- Bootstrap admin (created by seed.py) ----------
ADMIN_EMAIL=admin@sunpower.in
ADMIN_PASSWORD=admin123
